     "text": [
      "The dictionaly is: {5: 'amina', 7: 'raseel', 8: 'ayisha'}\n",
      "The merged dictionary is: {7: 'raseel', 8: 'ayisha', 5: 'amina', 9: 'ahmed'}\n"
     ]
    }
   ],
   "source": [
    "#accept 2 dictionaries and merge them\n",
    "print(\"enter 5 roll number of students:\")\n",
    "roll=input().split(\",\")\n",
    "print(\"Enter  5 names of students:\")\n",
    "name=input().split(\",\")\n",
    "dic1=dict(zip(map(int,roll),name))\n",
    "print(\"Enter 3 roll number of students:\")\n",
    "roll=input().split(\",\")\n",
    "print(\"Enter 3 names number of students:\")\n",
    "name=input().split(\",\")\n",
    "dic2=dict(zip(map(int,roll),name))\n",
    "print(\"The dictionaly is:\",dic2)\n",
    "dic1.update(dic2)\n",
    "print(\"The merged dictionary is:\",dic1)\n",
    "\n"
   ]
  },
