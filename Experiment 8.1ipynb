     "output_type": "stream",
     "text": [
      "enter 5 roll number of students:\n"
     ]
    },
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      " 3,6,8,4,9\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Enter 5 names of students:\n"
     ]
    },
    {
     "name": "stdin",
     "output_type": "stream",
     "text": [
      " fathima,shahana,hudha,sithara,rishana\n"
     ]
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The dictionary is: {3: 'fathima', 6: 'shahana', 8: 'hudha', 4: 'sithara', 9: 'rishana'}\n",
      "Ascending order : {3: 'fathima', 4: 'sithara', 6: 'shahana', 8: 'hudha', 9: 'rishana'}\n",
      "Descending order: {9: 'rishana', 8: 'hudha', 6: 'shahana', 4: 'sithara', 3: 'fathima'}\n"
     ]
    }
   ],
   "source": [
    "#accept 5 students roll no and name and sort them in ascending and descending order \n",
    "print(\"enter 5 roll number of students:\")\n",
    "roll=input().split(\",\")\n",
    "print(\"Enter 5 names of students:\")\n",
    "name=input().split(\",\")\n",
    "student=(dict(zip(map(int,roll),name)))\n",
    "ascending=dict(sorted(student.items()))\n",
    "descending=dict(sorted(student.items(),reverse=True))\n",
    "print(\"The dictionary is:\",student)\n",
    "print(\"Ascending order :\",ascending)\n",
    "print(\"Descending order:\",descending)"
   ]
  },
